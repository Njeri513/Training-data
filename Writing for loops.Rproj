#simulating some data
library(dplyr)
set.seed(123)
df_xyz <- tibble(
  x = rnorm(10),
  y = rnorm(10),
  z = rnorm(10)
) %>% print()

#if we wanted the mean we'd have written the code like this and note there is an error in how the mean of Z was calculated
df_xyz %>% 
  summarise(
    x_mean = mean(x),
    y_mean = mean(y),
    z_mean = mean(y)
  )
#alternatively we can use the across function to reduce repetition as demonstrated below
df_xyz %>%
  summarise(
    across(
      .cols  = everything(),
      .fns   = mean,
      .names = "{col}_mean"
    )
  )
#the alternative to the two methods above is to use the loop
xyz_means <- vector("double", ncol(df_xyz))

for(i in seq_along(df_xyz)) {
  xyz_means[[i]] <- mean(df_xyz[[i]])
}
xyz_means

#demonstration of for loops
for(i in 1) { print(i)}
for(i in c(1, 2, 3)) { print(i)}
#changed the index variable from i to x
for(x in c(1, 2, 3)) {print(x)}
#changed it into a word
for(number in c(1, 2, 3)) { print(number)}
for(i in df_xyz) {print(i)}

#for loops will not print the result unless you tell it to as seen below
for(i in df_xyz) { mean(i)}
for(i in df_xyz) { print(mean(i))}

#saving our analysis results to an object
xyz_means <- df_xyz %>%
  summarise(
    across(
      .cols  = everything(),
      .fns   = mean,
      .names = "{col}_mean"
    )
  )
#we can print them to the screen by
xyz_means

#trying to assign our mean to an object in a similar way having used for loops to find our mean
xyz_means <- for(i in df_xyz) {mean(i)}
xyz_means

#to rightfully do this we first create a numeric vector
my_vec <- vector()
my_vec
#changing it to a numeric vector with length 3
xyz_means <- vector("numeric", 3)
xyz_means
#this vector will return one value instead of 3 because when a new value comes into the equation it overwrites the previous one
xyz_means <- 0.07462564
xyz_means <- 0.208622
xyz_means <- -0.4245589
xyz_means

#the right way is to first create an empty vector
xyz_means <- vector("numeric", 3)
xyz_means
#then add a value to each of the slots
xyz_means[[1]] <- 0.07462564
xyz_means[[2]] <- 0.208622
xyz_means[[3]] <- -0.4245589
xyz_means

#combining this two steps in a for loop
for(i in c(1, 2, 3)) {print(i)}
#attempting to create our empty vector then combining the 2 steps
xyz_means <- vector("numeric", 3)
xyz_means
for(i in c(1, 2, 3)) { xyz_means[[i]] <- mean(df_xyz[[i]])}
xyz_means
#finally it worked
#for loop is used to reduce repetition in our code
#seq along () is used  when we dont know the number of columns in the dataframe but we'd like to iterate all over them. it will return a sequence of integers equal to the number of columns in the dataframe.
seq_along(df_xyz)

# adjusting the for loop using seq along()
xyz_means <- vector("numeric", 3)

for(i in seq_along(df_xyz)) {xyz_means[[i]] <- mean(df_xyz[[i]])}
xyz_means

#adding a fourth column to our dataframe
df_xyz <- df_xyz %>% mutate(a = rnorm(10)) %>% print()

#using our for loop() code
xyz_means <- vector("numeric", length(df_xyz)) # Using length() instead of 3

for(i in seq_along(df_xyz)) { # Using seq_along() instead of c(1, 2, 3)
  xyz_means[[i]] <- mean(df_xyz[[i]])
  }
xyz_means
#the above loop will give us the results we want regardless of the number of columns that we have

#using for loops in a function
multi_means <- function(data) {
  # Create a structure to contain results
  result <- vector("numeric", length(data))
  
  # Iterate over each column of data
  for(i in seq_along(data)) {
    result[[i]] <- mean(data[[i]])
  }
  
  # Return the result
  result
}
#attempting to use the function above
multi_means(df_xyz)
#we made the for loop flexible using length () and seq()

#simulating some data
set.seed(123)
new_df <- tibble(
  age    = rnorm(10, 50, 10),
  height = rnorm(10, 65, 5),
  weight = rnorm(10, 165, 10)
) %>% print()

#using the previously created function with this new dataset
multi_means(new_df)

#if you want the function to return informative names we add one more line to our code
xyz_means <- vector("numeric", length(df_xyz))

for(i in seq_along(df_xyz)) {
  xyz_means[[i]] <- mean(df_xyz[[i]])
  names(xyz_means)[[i]] <- paste0(names(df_xyz)[[i]], "_mean") # Name results here
}

xyz_means
#we can even make the names into a data frame
xyz_means %>% as.list() %>% as_tibble()

# a function using for loop that names the means and returns them as a dataframe
multi_means <- function(data) {
  # Create a structure to contain results
  result <- vector("numeric", length(data))
  
  # Iterate over each column of data
  for(i in seq_along(data)) {
    result[[i]] <- mean(data[[i]])
    names(result)[[i]] <- paste0(names(data)[[i]], "_mean")
  }
  
  # Return the result as a tibble
  as_tibble(as.list(result))
}
multi_means(new_df)

