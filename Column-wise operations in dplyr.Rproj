#created our own function to calculate values mean median etc
continuous_stats <- function(var) {
  study %>% 
    summarise(
      n_miss = sum(is.na({{ var }})),
      mean   = mean({{ var }}, na.rm = TRUE),
      median = median({{ var }}, na.rm = TRUE),
      min    = min({{ var }}, na.rm = TRUE),
      max    = max({{ var }}, na.rm = TRUE)
    )
}
continuous_stats(age)
continuous_stats(ht_in)
continuous_stats(wt_lbs)
continuous_stats(bmi)
#removing repetition in code 330 using across()
summary_stats <- study %>% 
  summarise(
    across(
      .cols = c(age, ht_in, wt_lbs, bmi),
      .fns  = list(
        n_miss = ~ sum(is.na(.x)),
        mean   = ~ mean(.x, na.rm = TRUE),
        median = ~ median(.x, na.rm = TRUE),
        min    = ~ min(.x, na.rm = TRUE),
        max    = ~ max(.x, na.rm = TRUE)
      )
    ) 
  ) %>%  print()

#the result is however hard to read so we pivot longer()
summary_stats %>% 
  tidyr::pivot_longer(
    cols      = everything(),
    names_to  = c("characteristic", ".value"),
    names_sep = "_"
  )
#the code above doesnt work as effectively as we wanted because the column names are separated by underscore rather than a character
summary_stats <- study %>% 
  summarise(
    across(
      .cols  = c(age, ht_in, wt_lbs, bmi),
      .fns   = list(
        n_miss = ~ sum(is.na(.x)),
        mean   = ~ mean(.x, na.rm = TRUE),
        median = ~ median(.x, na.rm = TRUE),
        min    = ~ min(.x, na.rm = TRUE),
        max    = ~ max(.x, na.rm = TRUE)
      ),
      .names = "{col}-{fn}" # This is the new part of the code
    ) 
  ) %>% print()
#ass a hyphen to the names_sep argument to pivot_longer()
summary_stats %>% 
  tidyr::pivot_longer(
    cols      = everything(),
    names_to  = c("characteristic", ".value"),
    names_sep = "-"
  )
#Across with filter
#removing a row with a missing value using the filter()
df_xyz %>% filter(!is.na(x)) #the second row has been removed

#calculating mean value of x
df_xyz %>% filter(!is.na(x)) %>% summarise(mean = mean(x))

#removing rows with missing values in any column not just x
df_xyz %>%  filter(!is.na(x)) %>% filter(!is.na(y)) %>% filter(!is.na(z))#using this code the data now has no missing values
#the above code still has a lot of repetition and can be alternatively written as
#please note that the across() cannot be used inside the filter()
df_xyz %>% 
  filter(
    if_all(
      .cols = c(x:z),
      .fns  = ~ !is.na(.x)
    )
  )
#is na returns true when the value is missing and false when the value is not missing
is.na(df_xyz$x)

#using ! to flip those results. True when the value is not missing and false when the value is missing
!is.na(df_xyz$x)

#using this to keep only non missing rows
df_xyz %>% filter(c(TRUE, FALSE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE, TRUE))

#repeating the same for y and z 
!is.na(df_xyz$y)
!is.na(df_xyz$z)

#bringing the results together to make it easier to view. In this dataframe true non missing false missing
not_missing <- tibble(
  row = 1:10,
  x   = !is.na(df_xyz$x),
  y   = !is.na(df_xyz$y),
  z   = !is.na(df_xyz$z)
) %>% print()

#if any will keep the row where any value of the row is true
df_xyz %>% 
  filter(
    if_any(
      .cols = c(x:z),
      .fns  = ~ !is.na(.x)
    )
  )
#if all keeps values where all values of the row are true
df_xyz %>% 
  filter(
    if_all(
      .cols = c(x:z),
      .fns  = ~ !is.na(.x)
    )
  )
